# ==============================================================================
# MANAS BOT — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit .env into version control. Keep all credentials private.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE & DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Environment mode: 'production' or 'development'
# In production, secure JWT_SECRET is strictly validated and enforced.
ENVIRONMENT=development

# Groq API Key for LLaMA 3.1 LLM Chat and Intent Inferences
# Obtain a free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Central PostgreSQL Database Connection URL
# Examples:
#   Neon / Supabase: postgresql://username:password@ep-pooler.region.neon.tech/manasbot?sslmode=require
#   Local:           postgresql://postgres:password@localhost:5432/manasbot
CENTRAL_DB_URL=postgresql://username:password@localhost:5432/manasbot

# Fernet 32-byte URL-safe base64 encryption key for API keys and sensitive settings
# Generate one using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_base64_fernet_encryption_key_here

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying employee/admin JWT access tokens.
# MUST be a strong, cryptographically random string (minimum 32 characters in production).
# Generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters

# JWT Token expiration window in hours
JWT_EXPIRE_HOURS=8

# Optional developer fallback password
SELLER_PASSWORD=your_secure_developer_password_here

# Allowed CORS Origins (comma-separated list of origins permitted to call the backend)
# In production, list your actual frontend domains and widget hosting origins.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000,https://manasbot.onrender.com,https://manasbot-1.onrender.com,https://manasbot-chatbot-widget.onrender.com

# ------------------------------------------------------------------------------
# EMAIL & SMTP NOTIFICATIONS (OPTIONAL / RECOMMENDED)
# ------------------------------------------------------------------------------
# Used for lead capture notifications, incident alerts, and payment reminders.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# ------------------------------------------------------------------------------
# METRICS & MONITORING ALERTS (OPTIONAL)
# ------------------------------------------------------------------------------
# Email address to receive traffic spike, high error rate, and token usage warnings
ALERT_EMAIL=your_alerts@domain.com
ALERT_TRAFFIC_RPM=50
ALERT_ERROR_RATE_PCT=20
ALERT_TOKENS_PER_MIN=50000
ALERT_COOLDOWN_MINUTES=15
